# Backend only. Do not prefix secrets with VITE_. No infrastructure is assumed.
CONTROL_DATABASE_URL=
CONTROL_ORIGIN=
CONTROL_OIDC_ISSUER=
CONTROL_OIDC_CLIENT_ID=
CONTROL_OIDC_CLIENT_SECRET=
CONTROL_SESSION_SECRET=
CONTROL_OFFLINE_SECONDS=90

# Public build configuration only. Full content of the Tauri .pub file and
# https://<production-domain>/api/app-update (no credentials/query/fragment).
# Release requires both; GitHub Actions reads them from Repository Variables.
CENTRAL_SOS_UPDATER_PUBLIC_KEY=
CENTRAL_SOS_UPDATER_URL=

# TAURI_SIGNING_PRIVATE_KEY and TAURI_SIGNING_PRIVATE_KEY_PASSWORD are GitHub
# Actions Secrets / signing-process environment only. Never store them in .env.
