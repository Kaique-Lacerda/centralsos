# Backend only. Do not prefix secrets with VITE_. No infrastructure is assumed.
CONTROL_DATABASE_URL=
CONTROL_ORIGIN=
CONTROL_OIDC_ISSUER=
CONTROL_OIDC_CLIENT_ID=
CONTROL_OIDC_CLIENT_SECRET=
CONTROL_SESSION_SECRET=
CONTROL_OFFLINE_SECONDS=90

# Compile-time Desktop configuration. Public key only; HTTPS latest.json endpoint.
CENTRAL_SOS_UPDATER_PUBLIC_KEY=
CENTRAL_SOS_UPDATER_URL=

# TAURI_SIGNING_PRIVATE_KEY and TAURI_SIGNING_PRIVATE_KEY_PASSWORD are supplied
# securely to the signing machine/build process. Never put their values here.
